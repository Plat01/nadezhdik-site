---
// Шапка новых страниц: маскот-ссылка на главную, соцсети, телефон, бургер-меню (как в T450 на главной).
// Лендинги направлений (tone="navy") ставят свой логотип вместо маскота и растягиваются на широкий контейнер.
import { site, nav } from '../data/site';

export interface HeaderLogo {
  src: string;
  alt: string;
  width: number;
  height: number;
}
interface Props {
  tone?: 'orange' | 'blue' | 'ink' | 'navy';
  logo?: HeaderLogo;
  wide?: boolean;
}
const { tone = 'orange', logo, wide = false } = Astro.props;
---
<header class:list={['header', `header--${tone}`]}>
  <div class:list={['container', { 'container--wide': wide }, 'header__bar']}>
    <a class:list={['header__logo', { 'header__logo--custom': logo }]} href="/" aria-label={`${site.name} — на главную`}>
      {logo ? <img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} /> : <img src="/brand/mascot.svg" alt="" width="56" height="56" />}
    </a>
    <div class="header__actions">
      {site.socials.map((s) => (
        <a class="header__social" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
          <img src={s.icon} alt="" width="44" height="44" />
        </a>
      ))}
      <a class="header__phone" href={site.phone.href} aria-label={`Позвонить: ${site.phone.label}`}>
        <svg viewBox="0 0 86 92" width="40" height="43" aria-hidden="true"><path fill="currentColor" d="M82.5 69.5C88 75.5 85.53 78.36 82 82.61l-4.35 3.78C65.3 94.72 46 97.26 19.5 68.13-7 39-1.4 18.01 8.55 6.96l4.38-3.81c4.7-2.91 7.07-4.85 11.57 0s6.5 8.85 8.78 13.21c2.27 4.36 1.66 10.72-2.79 13.7l-4.5 3.92c-4.52 3.92-6.82 8.5 4.5 21.52 11.32 13.02 18.28 13.8 22.8 9.89l2.16-1.88 1.78-2.14c3.53-4.25 10.61-3.38 14.2-1.12 3.58 2.25 5.58 3.25 11.08 9.25Z"/></svg>
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Меню">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="site-menu" class="menu" hidden>
    <button class="menu__close" type="button" aria-label="Закрыть меню">×</button>
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <a class="menu__phone" href={site.phone.href}>{site.phone.label}</a>
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.header__burger');
  const menu = document.getElementById('site-menu');
  const setOpen = (open: boolean) => {
    if (!burger || !menu) return;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  menu?.querySelector('.menu__close')?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .header { --header-accent: var(--c-cream); color: var(--c-cream); }
  .header--orange { background: var(--c-orange); }
  .header--blue { background: var(--c-blue); }
  .header--ink { background: var(--c-ink); }
  .header--navy { --header-accent: var(--c-red); background: var(--c-navy); }
  .header__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding-block: 20px; }
  .header__logo img { width: clamp(44px, 6vw, 56px); height: auto; }
  .header__logo--custom img { width: clamp(150px, 29.7vw, 565px); } /* 565 px на макете шириной 1900 */
  .header--navy .header__bar { padding-block: clamp(16px, 3.6vw, 68px) 0; }
  /* Макет English page (1900): иконки 55 px, телефон и бургер отнесены от соцсетей, правый край на 1534 px. */
  .header--navy .header__actions { margin-right: clamp(0px, 5vw, 96px); }
  .header--navy .header__social img { width: clamp(34px, 2.9vw, 55px); }
  .header--navy .header__phone { margin-left: clamp(8px, 10.5vw, 200px); }
  .header--navy .header__phone svg { width: clamp(30px, 2.9vw, 55px); }
  .header__actions { display: flex; align-items: center; gap: clamp(10px, 2vw, 16px); }
  .header__social img { width: clamp(34px, 4vw, 44px); height: auto; transition: transform 0.2s ease; }
  .header__social:hover img { transform: rotate(var(--tilt)) scale(1.08); }
  .header__phone { color: var(--header-accent); margin-left: clamp(8px, 3vw, 40px); }
  .header__phone svg { width: clamp(30px, 4vw, 44px); height: auto; }
  .header__burger { display: grid; gap: 7px; width: 46px; padding: 6px 0; background: none; border: 0; cursor: pointer; }
  .header__burger span { display: block; height: 7px; background: var(--header-accent); }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--gutter);
    background: var(--c-orange);
    color: var(--c-cream);
    font-family: var(--font-display);
    text-align: center;
  }
  .menu[hidden] { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .menu a { text-decoration: none; font-size: var(--fs-h1); text-transform: uppercase; }
  .menu a:hover { color: var(--c-ink); }
  .menu .menu__phone { font-size: var(--fs-h3); }
  .menu__close { position: absolute; top: 12px; right: var(--gutter); background: none; border: 0; color: var(--c-cream); font-size: 64px; line-height: 1; cursor: pointer; }
</style>
