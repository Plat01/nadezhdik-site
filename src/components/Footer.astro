---
// Подвал как на главной: оранжевое полотно с надписью НАДЕЖДИК и «хвостиком» пузыря, голубая полоса с маскотом и телефоном.
// variant="short" (лендинги направлений) — только голубая полоса с косым верхом и «хвостиком» на тёмно-синем фоне.
import { site } from '../data/site';

interface Props {
  variant?: 'full' | 'short';
}
const { variant = 'full' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['footer', `footer--${variant}`]}>
  {variant === 'full' && (
    <div class="footer__top">
      <div class="container">
        <slot />
        <img class="footer__wordmark" src="/brand/wordmark.svg" alt={site.name} width="1730" height="631" loading="lazy" />
      </div>
    </div>
  )}
  <div class="footer__bottom container">
    <a class="footer__credit" href={site.credit.href} target="_blank" rel="noopener">
      <img src={site.credit.image} alt={site.credit.label} loading="lazy" />
    </a>
    <p class="footer__legal">© {year} {site.legal}</p>
    <img class="footer__mascot" src="/brand/mascot.svg" alt="" width="346" height="343" loading="lazy" />
    <a class="footer__phone" href={site.phone.href}>{site.phone.label}</a>
  </div>
</footer>

<style>
  .footer {
    --slope: clamp(60px, 14vw, 200px); /* высота диагонали между оранжевой и голубой частью */
    background: var(--c-blue);
    color: var(--c-cream);
    font-family: var(--font-display);
  }
  .footer__top {
    background: var(--c-orange);
    padding-top: var(--space-5);
    padding-bottom: calc(var(--slope) + var(--space-2));
    clip-path: polygon(
      0 0, 100% 0,
      100% calc(100% - var(--slope)),
      44% calc(100% - var(--slope) * 0.45),
      34% 100%,
      34% calc(100% - var(--slope) * 0.47),
      0 calc(100% - var(--slope) * 0.2)
    );
  }
  .footer__wordmark { width: 100%; margin-top: var(--space-4); }
  .footer__bottom {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-4) var(--space-5);
    text-align: center;
  }
  .footer__credit { position: absolute; top: calc(var(--slope) * -0.55); right: 0; width: clamp(180px, 34vw, 410px); transform: rotate(-8deg); }
  .footer__credit img { transition: transform 0.2s ease; }
  .footer__credit:hover img { transform: scale(1.06); }
  .footer__legal { margin: 0; font-size: var(--fs-body); order: 3; }
  .footer__mascot { width: clamp(140px, 20vw, 240px); margin-top: var(--space-4); }
  .footer__phone { font-size: var(--fs-h2); text-decoration: none; white-space: nowrap; }

  /*
   * Короткий: только голубая полоса на тёмно-синем фоне. Край с «хвостиком» и положение элементов — как в подвале
   * главной (Zero Block rec1072865236, фигура rectangle_17.svg): на 320/480/960/1200 — px от левого края сетки
   * по центру, на 640–959 артборд Tilda тянется по ширине окна — там vw (px / 6.4).
   * Косой край тянется до краёв окна на любой ширине: левый отрезок продолжен с наклоном --sl от точки (--x1, --y1),
   * правый — с наклоном --s от (--x2, --y2). Если справа линии не хватает высоты, полоса опускается на --lift.
   */
  .footer--short { background: var(--c-navy); container-type: inline-size; }
  .footer--short .footer__bottom {
    --grid: calc(50cqw - 160px);
    --x1: 100px; --y1: 40px; --tail: 76px; --x2: 139px; --y2: 34px; --sl: 0.21; --s: 0.16;
    --lift: max(0px, var(--s) * (100cqw - var(--grid) - var(--x2)) - var(--y2));
    display: block;
    width: 100%;
    max-width: none;
    height: calc(371px + var(--lift));
    padding: 0;
    background: var(--c-blue);
    clip-path: polygon(
      0 calc(var(--y1) + var(--lift) + var(--sl) * (var(--grid) + var(--x1))),
      calc(var(--grid) + var(--x1)) calc(var(--y1) + var(--lift)),
      calc(var(--grid) + var(--x1)) calc(var(--tail) + var(--lift)),
      calc(var(--grid) + var(--x2)) calc(var(--y2) + var(--lift)),
      100% calc(var(--y2) + var(--lift) - var(--s) * (100cqw - var(--grid) - var(--x2))),
      100% 100%, 0 100%
    );
  }
  .footer--short .footer__bottom > * { position: absolute; margin: 0; }
  .footer--short .footer__credit { top: calc(26px + var(--lift)); left: calc(var(--grid) + 135px); right: auto; width: 177px; transform: none; }
  .footer--short .footer__mascot { top: calc(116px + var(--lift)); left: calc(var(--grid) + 96px); width: 120px; }
  .footer--short .footer__phone { top: calc(255px + var(--lift)); left: 0; right: 0; text-align: center; font-size: calc(var(--fs-phone) * 0.84); line-height: 1; }
  .footer--short .footer__legal { top: calc(314px + var(--lift)); left: 0; right: 0; text-align: center; font-size: var(--fs-small); line-height: 1; }

  @media (min-width: 480px) {
    .footer--short .footer__bottom {
      --grid: calc(50cqw - 240px);
      --x1: 138px; --y1: 61px; --tail: 115px; --x2: 198px; --y2: 51px; --sl: 0.232;
      height: calc(442px + var(--lift));
    }
    .footer--short .footer__credit { top: calc(36px + var(--lift)); left: calc(var(--grid) + 230px); width: 240px; }
    .footer--short .footer__mascot { top: calc(108px + var(--lift)); left: calc(var(--grid) + 180px); width: 120px; }
    .footer--short .footer__phone { top: calc(256px + var(--lift)); font-size: var(--fs-phone); }
    .footer--short .footer__legal { top: calc(325px + var(--lift)); font-size: var(--fs-h4); }
  }
  @media (min-width: 640px) and (max-width: 959.98px) {
    .footer--short .footer__bottom {
      height: 80.3vw;
      clip-path: polygon(0 17.8vw, 31.9% 11.6vw, 31.9% 22vw, 43.3% 9.8vw, 100% 0, 100% 100%, 0 100%);
    }
    .footer--short .footer__credit { top: 5.2vw; left: 48.4%; width: 49.7vw; }
    .footer--short .footer__mascot { top: 19.2vw; left: 34.4%; width: 37.5vw; }
    .footer--short .footer__phone { top: 55.3vw; font-size: max(var(--fs-phone), 6.72vw); }
    .footer--short .footer__legal { top: 66.1vw; font-size: max(var(--fs-h4), 3.44vw); }
  }
  @media (min-width: 960px) {
    .footer--short .footer__bottom {
      --grid: calc(50cqw - 480px);
      --x1: 300px; --y1: 119px; --tail: 225px; --x2: 418px; --y2: 100px; --sl: 0.21;
      height: calc(511px + var(--lift));
    }
    .footer--short .footer__credit { top: calc(47px + var(--lift)); left: calc(var(--grid) + 550px); width: 383px; }
    .footer--short .footer__mascot { top: calc(204px + var(--lift)); left: calc(var(--grid) + 470px); width: 200px; }
    .footer--short .footer__legal { top: calc(380px + var(--lift)); left: calc(var(--grid) + 10px); right: auto; text-align: start; font-size: var(--fs-h4); }
    .footer--short .footer__phone { top: calc(359px + var(--lift)); left: auto; right: calc(var(--grid) + 10px); font-size: var(--fs-phone); }
  }
  @media (min-width: 1200px) {
    .footer--short .footer__bottom {
      --grid: calc(50cqw - 600px);
      --x1: 408px; --y1: 127px; --tail: 240px; --x2: 533px; --y2: 107px; --sl: 0.164;
      height: calc(588px + var(--lift));
    }
    .footer--short .footer__credit { top: calc(61px + var(--lift)); left: calc(var(--grid) + 776px); width: 405px; }
    .footer--short .footer__mascot { top: calc(261px + var(--lift)); left: calc(var(--grid) + 556px); width: 240px; }
    .footer--short .footer__legal { top: calc(467px + var(--lift)); left: calc(var(--grid) + 20px); }
    .footer--short .footer__phone { top: calc(446px + var(--lift)); right: calc(var(--grid) + 20px); }
  }

  @media (min-width: 960px) {
    .footer__bottom { grid-template-columns: 1fr auto 1fr; align-items: end; text-align: start; }
    .footer__legal { order: 0; justify-self: start; font-size: var(--fs-h4); }
    .footer__phone { justify-self: end; }
  }
</style>
